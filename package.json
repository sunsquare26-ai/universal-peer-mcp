{
  "name": "universal-peer-mcp",
  "version": "0.1.0",
  "description": "Codex가 실행 중인 Claude Code 세션과 직접 대화하게 해주는 로컬 MCP 서버",
  "license": "Apache-2.0",
  "author": "이형석",
  "repository": "github:sunsquare26-ai/universal-peer-mcp",
  "type": "module",
  "private": false,
  "os": ["darwin"],
  "cpu": ["arm64"],
  "engines": { "bun": ">=1.3.0" },
  "bin": { "universal-peer-mcp": "src/cli.mjs" },
  "files": [
    "src/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "TRADEMARKS.md",
    "CONTRIBUTING.md",
    "COMPATIBILITY.md",
    "targets.example.json"
  ],
  "scripts": {
    "test": "bun test test/*.test.mjs",
    "check": "node --check src/cli.mjs && node --check src/server.mjs && node --check src/daemon.mjs",
    "build": "bun build src/cli.mjs --target=bun --outdir=dist"
  }
}
